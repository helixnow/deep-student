# video 宣传片工程（Remotion）——单独在 video 分支维护，main 不含。
# 大产物（out/ 渲染、node_modules、public/audio 配乐）由 video/.gitignore 与
# 下面这条整目录忽略共同兜底，避免误入库。
/video/
.plugin-build/

# opencode 派发运行记录（oc-dispatch.mjs）
/.oc-runs/
/.integration-dist/
/.integration-dist-demo/

# 迁移源码豁免：上面 LOG.* / MANIFEST-* / OPTIONS-* / CURRENT 等数据库文件规则在大小写不敏感文件系统（macOS）上
# 会误伤 log.ts、manifest-upload.ts 之类源码，导致 lane 本地能跑但文件从未进提交。源码与测试一律不受其影响。
!host/**/*.ts
!host/**/*.tsx
!electron/**/*.ts
!web/**/*.ts
!web/public/**
!web/index.html
!src/**/*.ts
!src/**/*.tsx
# src/version.ts 由 scripts/generate-version.mjs 生成，保持未跟踪；上面的 !src/**/*.ts 会把它重新放回。
src/version.ts
!scripts/**/*.mjs
# electron-builder 的 NSIS 自定义安装脚本必须入库（`**/build/` 会误伤 electron/build/）。
!electron/build/
!electron/build/installer.nsh

# 增量类型检查缓存（作业执行器/集成门禁）
*.tsbuildinfo

# Stale branch backup bundles (kept out of the repo)
*-branches-backup-*.bundle
