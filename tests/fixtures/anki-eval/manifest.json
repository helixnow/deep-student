      "entry": "stream",
      "chunkSize": 13,
      "description": "分隔符中间被注入空格（<<< ANKI_CARD_JSON_END>>>）。卡片本体合法，损坏分隔符应被自动消费。",
      "expected": {
        "cards": [
          { "outcome": "parse_ok", "lintCodes": [] },
          { "outcome": "parse_ok", "lintCodes": [] }
        ],
        "droppedProse": 0
      }
