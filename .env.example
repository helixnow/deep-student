# DeepStudent Environment Variables Example
# 复制此文件为 .env 并填入你的配置
# Copy this file to .env and fill in your configuration

# ============================================
# 🚀 Development Settings | 开发设置
# ============================================

# Enable smooth scrollbar (opt-in, may affect performance)
# 启用平滑滚动条（可选，可能影响性能）
# VITE_ENABLE_SMOOTH_SCROLL=false

# ============================================
# 📊 Telemetry & Error Reporting | 遥测与错误上报
# ============================================

# Sentry DSN for error reporting (optional)
# Sentry DSN 用于错误上报（可选）
# 留空则禁用 Sentry / Leave empty to disable Sentry
# VITE_SENTRY_DSN=
# Rust backend DSN（构建时嵌入；DSN 不是认证密钥）
# SENTRY_DSN=

# Sentry traces sample rate (0.0 - 1.0)
# Sentry 追踪采样率
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================
# 🍎 iOS Build Configuration | iOS 构建配置
# ============================================

# Apple Developer Team ID (required for iOS builds)
# Apple 开发者团队 ID（iOS 构建必需）
# IOS_TEAM_ID=YOUR_TEAM_ID

# iOS export method: development | ad-hoc | app-store | enterprise
# iOS 导出方式
# IOS_EXPORT_METHOD=ad-hoc

# iOS signing identity (usually auto-detected)
# iOS 签名身份（通常自动检测）
# IOS_SIGNING_IDENTITY=

# ============================================
# 🖥️ macOS Build Configuration | macOS 构建配置
# ============================================

# Apple signing identity for macOS
# macOS 签名身份
# APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name (TEAM_ID)

# Apple notarization keychain profile (recommended)
# Apple 公证钥匙串配置文件（推荐）
# APPLE_NOTARIZE_KEYCHAIN_PROFILE=ProfileName

# Alternative: Apple ID credentials for notarization
# 备选：用于公证的 Apple ID 凭据
# APPLE_ID=your-apple-id@email.com
# APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=YOUR_TEAM_ID

# ============================================
# 🤖 Android Build Configuration | Android 构建配置
# ============================================

# Android SDK path (required for Android builds)
# Android SDK 路径（Android 构建必需）
# ANDROID_HOME=/path/to/android/sdk

# Android NDK path
# Android NDK 路径
# NDK_HOME=$ANDROID_HOME/ndk/27.2.12479018

# Java JDK path (if not in system PATH)
# Java JDK 路径（如果不在系统 PATH 中）
# JAVA_HOME=/path/to/jdk-17

# Android keystore configuration (for release builds)
# Android 密钥库配置（用于发布构建）
# ANDROID_KEYSTORE_PATH=~/.android/release.keystore
# ANDROID_KEYSTORE_PASSWORD=your-password
# ANDROID_KEY_ALIAS=deepstudent
# ANDROID_KEY_PASSWORD=your-key-password

# ============================================
# 🔧 Build Optimization | 构建优化
# ============================================

# Skip frontend build (if unchanged)
# 跳过前端构建（如果未修改）
# SKIP_FRONTEND_BUILD=false

# Skip iOS native build (for re-export only)
# 跳过 iOS 原生构建（仅重新导出）
# SKIP_IOS_BUILD=false

# Skip entire build (for signing/notarization only)
# 跳过整个构建（仅签名/公证）
# SKIP_BUILD=false

# ============================================
# ⚠️ IMPORTANT SECURITY NOTES | 重要安全提示
# ============================================
#
# 1. NEVER commit .env files with real credentials to Git
#    绝不要将包含真实凭据的 .env 文件提交到 Git
#
# 2. Use environment-specific files: .env.ios, .env.macos, .env.android
#    使用特定环境的文件：.env.ios, .env.macos, .env.android
#
# 3. Set restrictive file permissions: chmod 600 .env
#    设置限制性文件权限：chmod 600 .env
#
# 4. Use Keychain Profile instead of plain-text passwords when possible
#    尽可能使用钥匙串配置文件而非明文密码
