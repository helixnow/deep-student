[Unit]
Description=在调度主循环外生成自动质量反馈（新问题写入 .oc-runs/reports/quality-feedback/，由守护进程投递）

[Service]
Type=oneshot
User=dsdev
Group=dsdev
Slice=dsdev.slice
WorkingDirectory=/home/dsdev/dev/deep-student
Environment=PATH=/opt/node26/bin:/home/dsdev/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/dsdev
Nice=10
ExecStart=/opt/node26/bin/node /home/dsdev/dev/deep-student/scripts/electron-migration/quality-feedback.mjs --spool --if-changed
TimeoutStartSec=15min
