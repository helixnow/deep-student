        { "cmd": "save_model_assignments", "args": { "assignments": { "model2_config_id": "x5-wave0-config" } } },
        { "cmd": "chat_v2_create_session", "args": { "mode": "chat", "title": "x5 wave0" } },
        { "cmd": "chat_v2_send_message", "args": { "request": { "sessionId": "${2.id}", "content": "固定问题",
