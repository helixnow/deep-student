        {
          "cmd": "skill_update_from_source",
          "args": {
            "skill_id": "w0-a"
          },
          "expect": "error"
        },
        {
          "cmd": "skill_check_updates",
          "args": {
            "skillIds": null
          }
        }
      ],
      "capture": {
        "events": true,
        "db": [
          "*"
        ]
      },
      "normalize": []
    },
    {
      "id": "skills.tap.arg_shape_errors",
      "seed": "empty",
      "steps": [
        {
          "cmd": "skill_tap_catalog",
          "args": {},
          "expect": "error"
        },
        {
          "cmd": "skill_tap_catalog",
          "args": {
            "repoUrl": null
          },
          "expect": "error"
        },
        {
          "cmd": "skill_tap_catalog",
          "args": {
            "repoUrl": 1
          },
          "expect": "error"
        },
        {
          "cmd": "skill_tap_catalog",
          "args": {
            "repo_url": "https://github.com/anthropics/skills"
          },
          "expect": "error"
        },
        {
          "cmd": "skill_tap_install",
          "args": {},
          "expect": "error"
        },
        {
          "cmd": "skill_tap_install",
          "args": {
            "zipUrl": "https://codeload.github.com/a/b/zip/main",
            "subdir": "x",
            "dryRun": true
          },
          "expect": "error"
        },
        {
          "cmd": "skill_tap_install",
          "args": {
            "zipUrl": "https://codeload.github.com/a/b/zip/main",
            "subdir": "x",
            "overwrite": null,
            "dryRun": true
          },
          "expect": "error"
        },
        {
          "cmd": "skill_tap_install",
          "args": {
            "zipUrl": "https://codeload.github.com/a/b/zip/main",
            "subdir": "x",
            "overwrite": "false",
            "dryRun": true
          },
          "expect": "error"
        },
        {
          "cmd": "skill_tap_install",
          "args": {
            "zipUrl": "https://codeload.github.com/a/b/zip/main",
            "overwrite": false,
            "dryRun": true
          },
          "expect": "error"
        },
        {
          "cmd": "skill_tap_install",
          "args": {
            "zipUrl": "https://codeload.github.com/a/b/zip/main",
            "subdir": null,
            "overwrite": false,
            "dryRun": true
          },
          "expect": "error"
        },
        {
          "cmd": "skill_tap_install",
          "args": {
            "zipUrl": null,
            "subdir": "x",
            "overwrite": false,
            "dryRun": true
          },
          "expect": "error"
        },
        {
          "cmd": "skill_tap_install",
          "args": {
            "zipUrl": "https://codeload.github.com/a/b/zip/main",
            "subdir": "x",
            "overwrite": false,
            "dryRun": "yes"
          },
          "expect": "error"
        },
        {
          "cmd": "skill_tap_install",
          "args": {
            "zipUrl": "https://codeload.github.com/a/b/zip/main",
            "subdir": "x",
            "overwrite": false,
            "dryRun": false,
            "expectedPackageSha256": 5
          },
          "expect": "error"
        },
        {
          "cmd": "skill_check_updates",
          "args": {
            "skillIds": null
          }
        }
      ],
      "capture": {
        "events": true,
        "db": [
          "*"
        ]
      },
      "normalize": []
    }
