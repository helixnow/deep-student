        { "cmd": "pin_images", "args": { "tempId": "tmp_full", "images": ["N1", "N2"] } },
        { "cmd": "get_setting", "args": { "key": "pinned_images:tmp_full" } },
        { "cmd": "pin_images", "args": { "tempId": "tmp_full", "images": ["N3"] } },
        { "cmd": "get_setting", "args": { "key": "pinned_images:tmp_full" } }
      ],
      "capture": { "events": true, "db": ["*"] },
      "normalize": []
