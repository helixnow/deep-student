              "capabilities": [
                "ds-columns-v1"
              ]
            }
          }
        },
        {
          "cmd": "notes_get_format",
          "args": {
            "noteId": "${1.id}"
          }
        },
        {
          "cmd": "dstu_create",
          "args": {
            "path": "/",
            "options": {
              "type": "note",
              "name": "列格式-块",
              "content": "# M\n\nBody\n"
            }
          }
        },
        {
          "cmd": "notes_history_current",
          "args": {
            "noteId": "${24.id}"
          }
        },
        {
          "cmd": "notes_migrate_blocks",
          "args": {
            "noteId": "${24.id}",
            "expectedUpdatedAt": "${25.updated_at}",
            "content": "<!-- ds:block-id=ma -->\n# M\n\n<!-- ds:block-id=mb -->\nBody\n"
          }
        },
        {
          "cmd": "notes_history_current",
          "args": {
            "noteId": "${24.id}"
          }
        },
        {
          "cmd": "notes_enable_columns",
          "args": {
            "noteId": "${24.id}",
            "expectedUpdatedAt": "${27.updated_at}"
          }
        },
        {
          "cmd": "notes_get_format",
          "args": {
            "noteId": "${24.id}"
          }
        },
        {
          "cmd": "dstu_delete",
          "args": {
            "path": "${1.path}"
          }
        },
        {
          "cmd": "notes_get_format",
          "args": {
            "noteId": "${1.id}"
          }
        },
        {
          "cmd": "notes_enable_columns",
          "args": {
            "noteId": "${1.id}",
            "expectedUpdatedAt": "${18.updated_at}"
          },
          "expect": "error"
        }
      ],
      "capture": {
        "events": true,
        "db": [
          "*"
        ]
      },
      "normalize": []
