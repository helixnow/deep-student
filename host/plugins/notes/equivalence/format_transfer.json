    {
      "id": "notes.format.get_and_enable_columns_under_lease",
      "seed": "empty",
      "steps": [
        {
          "cmd": "notes_history_set_retention",
          "args": {
            "policy": {
              "edit_bucket_seconds": 0,
              "max_edit_versions": null
            }
          }
        },
        {
          "cmd": "dstu_create",
          "args": {
            "path": "/",
            "options": {
              "type": "note",
              "name": "列格式",
              "content": "# 列\n\n正文\n"
            }
          }
        },
        {
          "cmd": "notes_get_format",
          "args": {
            "noteId": "${1.id}"
          }
        },
        {
          "cmd": "notes_get_format",
          "args": {
            "noteId": "note_missing_format"
          },
          "expect": "error"
        },
        {
          "cmd": "notes_get_format",
          "args": {},
          "expect": "error"
        },
        {
          "cmd": "notes_enable_columns",
          "args": {
            "noteId": "${1.id}",
            "expectedUpdatedAt": "stale-token"
          },
          "expect": "error"
        },
        {
          "cmd": "notes_enable_columns",
          "args": {
            "noteId": "note_missing_format",
            "expectedUpdatedAt": "x"
          },
          "expect": "error"
        },
        {
          "cmd": "notes_enable_columns",
          "args": {
            "noteId": "${1.id}"
          },
          "expect": "error"
        },
        {
          "cmd": "notes_editor_register",
          "args": {
            "noteId": "${1.id}"
          }
        },
        {
          "cmd": "notes_editor_begin",
          "args": {
            "participantId": "${8.participant_id}",
            "operationId": "wp230-columns",
            "noteIds": [
              "${1.id}"
            ]
          }
        },
        {
          "cmd": "notes_history_current",
          "args": {
            "noteId": "${1.id}"
          }
        },
        {
          "cmd": "notes_editor_freeze_ack",
          "args": {
            "lease": {
              "participant_id": "${8.participant_id}",
              "token": "${9.token}"
            },
            "draft": {
              "markdown": "${10.content_md}",
              "expected_updated_at": "${10.updated_at}"
            }
          }
        },
        {
          "cmd": "notes_editor_flush",
          "args": {
            "lease": {
              "participant_id": "${8.participant_id}",
              "token": "${9.token}"
            },
            "noteId": "${1.id}",
            "capabilities": [
              "ds-columns-v1"
            ]
          }
        },
        {
          "cmd": "notes_enable_columns",
          "args": {
            "noteId": "${1.id}",
            "expectedUpdatedAt": "${10.updated_at}"
          },
          "expect": "error"
        },
        {
          "cmd": "notes_enable_columns",
          "args": {
            "noteId": "${1.id}",
            "expectedUpdatedAt": "${10.updated_at}",
            "lease": {
              "participant_id": "nep_missing",
              "token": "nel_missing"
            }
          },
          "expect": "error"
        },
        {
          "cmd": "notes_enable_columns",
          "args": {
            "noteId": "${1.id}",
            "expectedUpdatedAt": "${10.updated_at}",
            "lease": {
              "participant_id": "${8.participant_id}",
              "token": "${9.token}"
            }
          }
        },
        {
          "cmd": "notes_editor_release",
          "args": {
            "lease": {
              "participant_id": "${8.participant_id}",
              "token": "${9.token}"
            },
            "cancel": true
          }
        },
        {
          "cmd": "notes_editor_unregister",
          "args": {
            "participantId": "${8.participant_id}"
          }
        },
        {
          "cmd": "notes_history_current",
          "args": {
            "noteId": "${1.id}"
          }
        },
        {
          "cmd": "notes_enable_columns",
          "args": {
            "noteId": "${1.id}",
            "expectedUpdatedAt": "${18.updated_at}"
          }
        },
        {
          "cmd": "notes_get_format",
          "args": {
            "noteId": "${1.id}"
          }
        },
        {
          "cmd": "notes_history_current",
          "args": {
            "noteId": "${1.id}"
          }
        },
        {
          "cmd": "notes_update",
          "args": {
            "note": {
              "id": "${1.id}",
              "content_md": ":::ds-columns{version=1 layout=cornell}\n\n:::column\n\n## Cues\n\nQuestion\n\n:::end-column\n\n:::column\n\n## Notes\n\nAnswer\n\n:::end-column\n\n:::end-ds-columns\n",
