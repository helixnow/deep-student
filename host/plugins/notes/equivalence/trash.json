          "cmd": "notes_hard_delete",
          "args": {
            "subject": "_global",
            "id": "${2.id}"
          }
        },
        {
          "cmd": "notes_list_deleted",
          "args": {
            "subject": "_global",
            "page": 0,
            "page_size": 20
