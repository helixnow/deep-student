          "args": {
            "taskId": "${5.0.id}"
          }
        },
        {
          "cmd": "cancel_document_processing",
          "args": {
            "documentId": "${2}"
          }
        },
        {
          "cmd": "get_document_tasks",
          "args": {
            "documentId": "${2}"
          }
        },
        {
          "cmd": "get_document_processing_state",
          "args": {
            "documentId": "${2}"
          }
        },
        {
          "cmd": "list_document_sessions",
          "args": {}
        }
