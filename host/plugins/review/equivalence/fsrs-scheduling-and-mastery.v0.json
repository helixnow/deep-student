    {
      "id": "review.schedule.default-four-ratings",
      "seed": "empty",
      "steps": [
        {"cmd": "save_anki_cards", "args": {"request": {"cards": [{"front": "Again", "back": "1"}, {"front": "Hard", "back": "2"}, {"front": "Good", "back": "3"}, {"front": "Easy", "back": "4"}]}}},
        {"cmd": "fsrs_enqueue_cards", "args": {"ankiCardIds": "${0.savedIds}"}},
        {"cmd": "fsrs_preview_intervals", "args": {"cardStateId": "${1.states.0.id}"}},
        {"cmd": "fsrs_rate", "args": {"cardStateId": "${1.states.0.id}", "rating": 1, "durationMs": null}},
        {"cmd": "fsrs_rate", "args": {"cardStateId": "${1.states.1.id}", "rating": 2, "durationMs": 0}},
        {"cmd": "fsrs_rate", "args": {"cardStateId": "${1.states.2.id}", "rating": 3, "durationMs": 1234}},
        {"cmd": "fsrs_rate", "args": {"cardStateId": "${1.states.3.id}", "rating": 4, "durationMs": 3600001}},
        {"cmd": "fsrs_get_memory_overview", "args": {"recentLimit": 2}},
        {"cmd": "fsrs_get_review_statistics", "args": {"days": 7}},
        {"cmd": "fsrs_get_card_memory_history", "args": {"cardStateId": "${1.states.3.id}"}},
        {"cmd": "mastery_get_overview", "args": {}}
      ],
      "capture": {"events": true, "db": ["*"]}, "normalize": []
    },
