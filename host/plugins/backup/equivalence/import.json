        {
          "cmd": "data_governance_import_zip",
          "args": {
            "zipPath": "../nonexistent-wp073.zip"
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_import_zip",
          "args": {
            "zipPath": "/nonexistent-wp073/a\u0000b.zip"
          },
          "expect": "error"
        },
        {
