            "zipPath": "/nonexistent-wp073/backup.zip",
            "backupId": "备份"
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_import_zip",
          "args": {
            "zipPath": "/tmp/..//nonexistent-wp073/backup.zip",
            "backupId": "../x"
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_import_zip",
          "args": {
            "zipPath": "/nonexistent-wp073/backup.zip",
            "backupId": " wp073_import "
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_import_zip",
          "args": {
            "zipPath": "/nonexistent-wp073/backup.zip",
            "backupId": null
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_import_zip",
          "args": {
            "zipPath": "/nonexistent-wp073/backup.zip"
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_list_backup_jobs",
          "args": {}
        },
        {
          "cmd": "data_governance_get_backup_list",
          "args": {}
        }
      ],
      "capture": {
        "events": true,
        "db": [
          "*"
        ]
      },
      "normalize": []
    },
    {
