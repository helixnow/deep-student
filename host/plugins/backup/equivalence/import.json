{
  "domain": "backup",
  "commands": [
    "data_governance_import_zip",
    "data_governance_list_backup_jobs",
    "data_governance_get_backup_list"
  ],
  "scenarios": [
    {
      "id": "backup.import.sync.backup_id_checked_before_path",
      "seed": "empty",
      "steps": [
        {
          "cmd": "data_governance_import_zip",
          "args": {
            "zipPath": "/nonexistent-wp073/backup.zip",
            "backupId": ""
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_import_zip",
          "args": {
            "zipPath": "/nonexistent-wp073/backup.zip",
            "backupId": "   "
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_import_zip",
          "args": {
            "zipPath": "/nonexistent-wp073/backup.zip",
            "backupId": "%FF"
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_import_zip",
          "args": {
            "zipPath": "/nonexistent-wp073/backup.zip",
            "backupId": "a%20b"
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_import_zip",
          "args": {
            "zipPath": "/nonexistent-wp073/backup.zip",
            "backupId": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_import_zip",
          "args": {
            "zipPath": "/nonexistent-wp073/backup.zip",
            "backupId": "../x"
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_import_zip",
