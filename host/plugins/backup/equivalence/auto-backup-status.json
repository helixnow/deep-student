        {"cmd": "get_auto_backup_status", "args": {}}
      ],
      "capture": {"events": true, "db": ["*"]},
      "normalize": []
    },
    {
      "id": "backup.auto_status.partial_nullable",
      "seed": "empty",
      "steps": [
        {"cmd": "save_setting", "args": {"key": "backup.auto_backup_status", "value": "{\"lastError\":null,\"lastJobId\":\"g3-auto-backup-job\"}"}},
        {"cmd": "get_auto_backup_status", "args": {}}
      ],
      "capture": {"events": true, "db": ["*"]},
