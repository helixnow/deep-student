{
  "domain": "backup",
  "commands": [
    "data_governance_run_backup",
    "data_governance_backup_tiered",
    "data_governance_cancel_backup",
    "data_governance_list_backup_jobs",
    "data_governance_get_backup_list",
    "data_governance_get_backup_job",
    "data_governance_delete_backup"
  ],
  "scenarios": [
    {
      "id": "backup.run_backup.incremental_rejected",
      "seed": "empty",
      "steps": [
        {
          "cmd": "data_governance_run_backup",
          "args": {
            "backupType": "incremental"
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_run_backup",
          "args": {
            "backupType": "incremental",
            "baseVersion": "20260101_000000_x",
            "includeAssets": false
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_list_backup_jobs",
          "args": {}
        },
        {
          "cmd": "data_governance_delete_backup",
          "args": {
            "backupId": "wp234_barrier_missing"
          },
          "expect": "error"
        }
      ],
      "capture": {
        "events": true,
        "db": [
          "*"
        ]
      },
      "normalize": []
    },
    {
      "id": "backup.run_backup.backup_type_case_and_unknown",
