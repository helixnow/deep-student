{
  "domain": "backup",
  "commands": [
    "data_governance_backup_and_export_zip",
    "data_governance_list_backup_jobs"
  ],
  "scenarios": [
    {
      "id": "backup.backup_and_export_zip.sync_errors",
      "seed": "empty",
      "steps": [
        {
          "cmd": "data_governance_backup_and_export_zip",
          "args": {
            "outputPath": "content%3A%2F%2Fcom.android.externalstorage.documents%2Fdocument%2Fprimary%3Awp234.zip"
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_backup_and_export_zip",
          "args": {
            "outputPath": "content://com.android.externalstorage.documents/document/primary%3Awp234.zip\r"
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_backup_and_export_zip",
          "args": {
            "outputPath": "content:"
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_backup_and_export_zip",
          "args": {
            "outputPath": "/nonexistent-wp234/a\u0000b.zip"
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_backup_and_export_zip",
          "args": {
            "outputPath": "/nonexistent-wp234/../x.zip"
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_backup_and_export_zip",
          "args": {
            "outputPath": ".."
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_backup_and_export_zip",
          "args": {},
          "expect": "error"
        },
        {
          "cmd": "data_governance_backup_and_export_zip",
          "args": {
            "outputPath": null
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_backup_and_export_zip",
          "args": {
            "outputPath": 1
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_backup_and_export_zip",
          "args": {
            "outputPath": "/nonexistent-wp234/x.zip",
            "compressionLevel": -1
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_backup_and_export_zip",
          "args": {
            "outputPath": "/nonexistent-wp234/x.zip",
            "addToBackupList": "yes"
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_backup_and_export_zip",
          "args": {
            "outputPath": "/nonexistent-wp234/x.zip",
            "tiers": "core"
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_backup_and_export_zip",
          "args": {
            "outputPath": "/nonexistent-wp234/x.zip",
            "encryptionPassword": 1
          },
          "expect": "error"
        },
        {
          "cmd": "data_governance_list_backup_jobs",
          "args": {}
        }
      ],
      "capture": {
        "events": true,
        "db": [
          "*"
        ]
      },
      "normalize": []
    }
  ]
}
