{
  "domain": "vfs-index",
  "commands": ["optimize_chat_embeddings_table", "save_setting", "get_setting"],
  "scenarios": [
    {
      "id": "vfs_index.optimize_chat.frontend_snake_keys",
      "seed": "empty",
      "steps": [
        { "cmd": "optimize_chat_embeddings_table", "args": { "older_than_days": 7, "delete_unverified": false, "force": true } },
        { "cmd": "get_setting", "args": { "key": "lance.optimize.last.chat" } }
      ],
      "capture": { "events": true, "db": ["*"] },
      "normalize": []
    },
    {
      "id": "vfs_index.optimize_chat.frontend_days_omitted",
      "seed": "empty",
      "steps": [
        { "cmd": "optimize_chat_embeddings_table", "args": { "delete_unverified": true, "force": true } },
        { "cmd": "get_setting", "args": { "key": "lance.optimize.last.chat" } }
      ],
      "capture": { "events": true, "db": ["*"] },
      "normalize": []
    },
