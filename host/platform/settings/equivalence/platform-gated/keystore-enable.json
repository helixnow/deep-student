{
  "domain": "settings",
  "commands": [
    "secure_store_set_keystore_protection"
  ],
  "scenarios": [
    {
      "id": "settings.keystore.platform.enable_then_disable",
      "seed": "empty",
      "steps": [
        {
          "cmd": "secure_save_cloud_credentials",
          "args": {
            "credentials": {
              "webdavPassword": "dav-secret"
            },
            "encryptionPasswordIsPreexisting": false
          }
        },
        {
          "cmd": "secure_store_set_keystore_protection",
          "args": {
            "enabled": true
          }
        },
        {
          "cmd": "secure_store_get_keystore_protection",
          "args": {}
        },
        {
          "cmd": "secure_get_cloud_credentials",
          "args": {}
        },
        {
          "cmd": "secure_store_set_keystore_protection",
          "args": {
            "enabled": false
          }
        },
        {
          "cmd": "secure_store_get_keystore_protection",
          "args": {}
        },
        {
          "cmd": "secure_get_cloud_credentials",
          "args": {}
        }
      ],
      "capture": {
        "events": true,
        "db": [
          "*"
        ]
      },
      "normalize": []
    },
    {
      "id": "settings.keystore.platform.enable_empty_store",
      "seed": "empty",
      "steps": [
        {
          "cmd": "secure_store_set_keystore_protection",
          "args": {
            "enabled": true
          }
        },
        {
          "cmd": "secure_store_get_keystore_protection",
          "args": {}
        },
        {
          "cmd": "secure_store_is_available",
          "args": {}
        }
      ],
      "capture": {
        "events": true,
        "db": [
          "*"
        ]
      },
      "normalize": []
    }
  ]
}
