{
  "$comment": "前端分层图（scripts/check-frontend-layers.mjs 读取）。layers 按从低到高排列；src/ 下每个顶层目录/顶层文件都必须恰好归入一层，新增顶层目录未登记时脚本直接失败。归类理由见脚本头部注释。",
  "layers": [
    {
      "name": "foundation",
      "entries": ["types", "config", "lib", "shared", "locales", "data", "polyfills", "shims", "assets", "version.ts", "vite-env.d.ts"]
    },
    {
      "name": "platform",
      "entries": ["api", "services", "stores", "store", "events", "logging", "utils", "hooks", "contexts", "mcp", "engines", "dstu", "boot", "plugin-runtime", "i18n.ts", "ui-kernel", "platform"]
    },
    {
      "name": "ui",
      "entries": ["components", "styles", "ui-sdk"]
    },
    {
      "name": "feature",
      "entries": ["features", "command-palette", "essay-grading", "quick-assistant", "translation", "voice-input", "promptkit", "menu", "plugins"]
    },
    {
      "name": "app",
      "entries": ["App.tsx", "main.tsx", "app", "lazyComponents.tsx", "reactRoot.ts", "dev", "debug-panel", "mcp-debug", "demo", "button-audit", "ui-plugins", "__tests__"]
    }
  ]
}
