{
  "lane": "F1-kernel",
  "commands": [
    {
      "name": "plugin:ui|ready",
      "host": { "file": "host/kernel/core.ts", "const": "UI_READY_COMMAND", "handler": "host/kernel/runtime.ts" },
      "args": [
        { "key": "id", "optional": false, "schema": { "type": "string" } },
        { "key": "version", "optional": false, "schema": { "type": "string" } }
      ],
      "result": { "description": "{id:string,matched:boolean}; mismatch unloads and degrades the plugin" }
    },
    {
      "name": "plugin:manager|set-trust",
      "host": { "file": "host/kernel/core.ts", "const": "PLUGIN_MANAGER_SET_TRUST_COMMAND", "handler": "host/kernel/plugin-admin.ts" },
      "args": [
        { "key": "id", "optional": false, "schema": { "type": "string" } },
        { "key": "version", "optional": false, "schema": { "type": "string" } },
        { "key": "permissions", "optional": false, "schema": { "type": "array", "items": { "type": "string" } } },
        { "key": "trust", "optional": false, "schema": { "type": "string", "enum": ["full", "restricted"] } },
        { "key": "confirmed", "optional": false, "schema": { "const": true } }
      ],
      "result": { "description": "PluginManagerConsentView with trust/source; exact user confirmation, same-process code" }
    },
    {
      "name": "plugin:manager|list",
      "host": { "file": "host/kernel/core.ts", "const": "PLUGIN_MANAGER_LIST_COMMAND", "handler": "host/kernel/plugin-admin.ts" },
      "args": [],
      "result": { "description": "PluginManagerInventory (host/kernel/core.ts); transport-authenticated main local page only" }
    },
    {
      "name": "plugin:manager|update-impact",
      "host": { "file": "host/kernel/core.ts", "const": "PLUGIN_MANAGER_UPDATE_IMPACT_COMMAND", "handler": "host/kernel/plugin-admin.ts" },
      "args": [{ "key": "version", "optional": false, "schema": { "type": "string" } }],
      "result": { "description": "PluginUpdateImpact; read-only manifest screening for the authenticated main page" }
    },
    {
      "name": "plugin:manager|config",
      "host": { "file": "host/kernel/core.ts", "const": "PLUGIN_MANAGER_CONFIG_COMMAND", "handler": "host/kernel/plugin-admin.ts" },
      "args": [{ "key": "id", "optional": false, "schema": { "type": "string" } }],
      "result": { "description": "PluginManagerConfigView (host/kernel/core.ts)" }
    },
    {
      "name": "plugin:manager|config|save",
      "host": { "file": "host/kernel/core.ts", "const": "PLUGIN_MANAGER_CONFIG_SAVE_COMMAND", "handler": "host/kernel/plugin-admin.ts" },
      "args": [
        { "key": "id", "optional": false, "schema": { "type": "string" } },
        { "key": "revision", "optional": false, "schema": { "type": "string" } },
        { "key": "values", "optional": false, "schema": {} }
      ],
      "result": { "description": "{id:string,revision:string}" }
    },
    {
      "name": "plugin:manager|set-enabled",
      "host": { "file": "host/kernel/core.ts", "const": "PLUGIN_MANAGER_SET_ENABLED_COMMAND", "handler": "host/kernel/plugin-admin.ts" },
      "args": [
        { "key": "id", "optional": false, "schema": { "type": "string" } },
        { "key": "revision", "optional": false, "schema": { "type": "string" } },
        { "key": "enabled", "optional": false, "schema": { "type": "boolean" } }
      ],
      "result": { "description": "{id:string,enabled:boolean,revision:string}" }
    },
    {
      "name": "plugin:manager|uninstall",
      "host": { "file": "host/kernel/core.ts", "const": "PLUGIN_MANAGER_UNINSTALL_COMMAND", "handler": "host/kernel/plugin-admin.ts" },
      "args": [
        { "key": "id", "optional": false, "schema": { "type": "string" } },
        { "key": "revision", "optional": false, "schema": { "type": "string" } }
      ],
      "result": { "description": "{id:string,removed:boolean,revision:string}" }
    },
    {
      "name": "plugin:manager|consent",
      "host": { "file": "host/kernel/core.ts", "const": "PLUGIN_MANAGER_CONSENT_COMMAND", "handler": "host/kernel/plugin-admin.ts" },
      "args": [
        { "key": "id", "optional": false, "schema": { "type": "string" } },
        { "key": "version", "optional": false, "schema": { "type": "string" } },
        { "key": "permissions", "optional": false, "schema": { "type": "array", "items": { "type": "string" } } }
      ],
      "result": { "description": "PluginManagerConsentView (host/kernel/core.ts)" }
    },
    {
      "name": "plugin:manager|install",
      "host": { "file": "host/kernel/core.ts", "const": "PLUGIN_MANAGER_INSTALL_COMMAND", "handler": "host/kernel/plugin-admin.ts" },
      "args": [
        { "key": "path", "optional": false, "schema": { "type": "string" } },
        { "key": "revision", "optional": false, "schema": { "type": "string" } }
      ],
      "result": { "description": "PluginManagerInstallResult (host/kernel/core.ts); installed disabled, never implies consent or running" }
    },
    {
      "name": "plugin:ui|manifest",
      "host": { "file": "host/kernel/core.ts", "const": "UI_MANIFEST_COMMAND", "handler": "host/kernel/runtime.ts" },
      "description": "UI 引导清单：已装载插件中声明了 meta.ui 的 UI 半模块（docs/plugins/FRONTEND.md §3）。带 version: 2 时返回 UI 清单 v2：全部已装插件（来源、平台、safeMode）与未安装的插件（FE-A3）。",
      "args": [
        { "key": "version", "optional": true, "schema": { "type": "integer", "enum": [1, 2] } }
      ],
      "result": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "id": { "type": "string" }, "file": { "type": "string" }, "version": { "type": "string" } },
              "required": ["id", "file"],
              "additionalProperties": false
            }
          },
          {
            "type": "object",
            "properties": {
              "version": { "const": 2 },
              "plugins": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "origin": { "enum": ["builtin", "community"] },
                    "platforms": { "type": "array", "items": { "enum": ["desktop", "mobile"] } },
                    "version": { "type": "string" },
                    "file": { "type": "string" }
                  },
                  "required": ["id", "origin", "platforms"],
                  "additionalProperties": false
                }
              },
              "degraded": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": { "id": { "type": "string" }, "reason": { "type": "string" } },
                  "required": ["id", "reason"],
                  "additionalProperties": false
                }
              },
              "safeMode": { "type": "boolean", "description": "本次 Host 会话是否处于安全模式（W06 --safe-mode）：仅官方插件，社区 UI 不得装载。" }
            },
            "required": ["version", "plugins", "degraded", "safeMode"],
            "additionalProperties": false
          }
        ]
      }
    },
    {
      "name": "plugin:host|call",
      "host": { "file": "host/kernel/core.ts", "const": "HOST_CALL_COMMAND", "handler": "host/kernel/runtime.ts" },
      "description": "UI 调用插件 meta.remote 放行的服务方法（docs/plugins/FRONTEND.md §5）；参数与返回值都必须是纯 JSON。caller 是调用方 UI 半的插件 id，必填（SEC-E06；Host 默认 require，缺了即拒绝）。",
      "args": [
        { "key": "caller", "optional": false, "schema": { "type": "string", "minLength": 1 } },
        { "key": "service", "optional": false, "schema": { "type": "string", "minLength": 1 } },
        { "key": "method", "optional": false, "schema": { "type": "string", "minLength": 1 } },
        { "key": "args", "optional": false, "schema": { "type": "array" } }
      ],
      "result": { "description": "被调用服务方法的返回值（纯 JSON）" },
      "error": { "$ref": "_shared.json#/$defs/AppError" }
    },
    {
      "name": "plugin:host|status",
      "host": { "file": "host/kernel/core.ts", "const": "HOST_STATUS_COMMAND", "handler": "host/kernel/runtime.ts" },
      "description": "本次 profile 装载中未安装的插件及原因。",
      "args": [],
      "result": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": { "id": { "type": "string" }, "reason": { "type": "string" } },
          "required": ["id", "reason"],
          "additionalProperties": false
        }
      }
    },
    {
      "name": "vfs_study_space_get_profile",
      "host": { "file": "host/plugins/vfs/src/study-spaces.ts", "const": "VFS_STUDY_SPACE_GET_PROFILE_COMMAND", "handler": "host/plugins/vfs/src/plugin.ts" },
      "args": [
        { "key": "spaceId", "optional": true, "schema": { "type": "string" } }
      ],
      "result": { "description": "StudySpaceProfile | null" }
    },
    {
      "name": "vfs_study_space_list_profiles",
      "host": { "file": "host/plugins/vfs/src/study-spaces.ts", "const": "VFS_STUDY_SPACE_LIST_PROFILES_COMMAND", "handler": "host/plugins/vfs/src/plugin.ts" },
      "args": [],
      "result": { "type": "array", "items": { "type": "object" } }
    },
    {
      "name": "vfs_study_space_upsert_profile",
      "host": { "file": "host/plugins/vfs/src/study-spaces.ts", "const": "VFS_STUDY_SPACE_UPSERT_PROFILE_COMMAND", "handler": "host/plugins/vfs/src/plugin.ts" },
      "args": [
        { "key": "input", "optional": false, "schema": { "type": "object" } }
      ],
      "result": { "type": "object" }
    },
    {
      "name": "vfs_study_space_delete_profile",
      "host": { "file": "host/plugins/vfs/src/study-spaces.ts", "const": "VFS_STUDY_SPACE_DELETE_PROFILE_COMMAND", "handler": "host/plugins/vfs/src/plugin.ts" },
      "args": [
        { "key": "spaceId", "optional": true, "schema": { "type": "string" } }
      ],
      "result": { "type": "boolean" }
    },
    {
      "name": "vfs_space_mount_list",
      "host": { "file": "host/plugins/vfs/src/study-spaces.ts", "const": "VFS_SPACE_MOUNT_LIST_COMMAND", "handler": "host/plugins/vfs/src/plugin.ts" },
      "args": [
        { "key": "spaceId", "optional": true, "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }] } },
        { "key": "targetFolderId", "optional": true, "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }] } },
        { "key": "itemType", "optional": true, "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }] } },
        { "key": "itemId", "optional": true, "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }] } }
      ],
      "result": { "type": "array", "items": { "type": "object" } }
    },
    {
      "name": "vfs_space_mount_add",
      "host": { "file": "host/plugins/vfs/src/study-spaces.ts", "const": "VFS_SPACE_MOUNT_ADD_COMMAND", "handler": "host/plugins/vfs/src/plugin.ts" },
      "args": [
        { "key": "input", "optional": false, "schema": { "type": "object" } }
      ],
      "result": { "type": "object" }
    },
    {
      "name": "vfs_space_mount_remove",
      "host": { "file": "host/plugins/vfs/src/study-spaces.ts", "const": "VFS_SPACE_MOUNT_REMOVE_COMMAND", "handler": "host/plugins/vfs/src/plugin.ts" },
      "args": [
        { "key": "mountId", "optional": true, "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }] } },
        { "key": "targetFolderId", "optional": true, "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }] } },
        { "key": "itemType", "optional": true, "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }] } },
        { "key": "itemId", "optional": true, "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }] } },
        { "key": "input", "optional": true, "schema": { "anyOf": [{ "type": "object" }, { "type": "null" }] } }
      ],
      "result": { "type": "boolean" }
    },
    {
      "name": "vfs_ensure_inbox_folder",
      "host": { "file": "host/plugins/vfs/src/study-spaces.ts", "const": "VFS_ENSURE_INBOX_FOLDER_COMMAND", "handler": "host/plugins/vfs/src/plugin.ts" },
      "args": [],
      "result": { "type": "object" }
    },
    {
      "name": "vfs_anchor_edges_upsert",
      "host": { "file": "host/plugins/vfs/src/study-spaces.ts", "const": "VFS_ANCHOR_EDGES_UPSERT_COMMAND", "handler": "host/plugins/vfs/src/plugin.ts" },
      "args": [
        { "key": "edges", "optional": true, "schema": { "type": "array", "items": { "type": "object" } } }
      ],
      "result": { "type": "object" }
    },
    {
      "name": "vfs_anchor_edges_delete_by_source",
      "host": { "file": "host/plugins/vfs/src/study-spaces.ts", "const": "VFS_ANCHOR_EDGES_DELETE_BY_SOURCE_COMMAND", "handler": "host/plugins/vfs/src/plugin.ts" },
      "args": [
        { "key": "sourceKind", "optional": true, "schema": { "type": "string" } },
        { "key": "sourceResourceId", "optional": true, "schema": { "type": "string" } },
        { "key": "keepEdgeIds", "optional": true, "schema": { "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "null" }] } }
      ],
      "result": { "type": "object" }
    },
    {
      "name": "vfs_anchor_edges_query_by_target",
      "host": { "file": "host/plugins/vfs/src/study-spaces.ts", "const": "VFS_ANCHOR_EDGES_QUERY_BY_TARGET_COMMAND", "handler": "host/plugins/vfs/src/plugin.ts" },
      "args": [
        { "key": "targetResourceIds", "optional": true, "schema": { "type": "array", "items": { "type": "string" } } },
        { "key": "targetKind", "optional": true, "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }] } }
      ],
      "result": { "type": "array", "items": { "type": "object" } }
    }
  ],
  "events": [
    {
      "name": "host://ui-manifest",
      "host": { "file": "host/kernel/core.ts", "const": "UI_MANIFEST_EVENT", "handler": "host/kernel/runtime.ts" },
      "description": "UI 引导清单变化（启动、插件装卸、profile 回退），payload 与 plugin:ui|manifest 的返回值相同。",
      "payload": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": { "id": { "type": "string" }, "file": { "type": "string" }, "version": { "type": "string" } },
          "required": ["id", "file"],
          "additionalProperties": false
        }
      }
    },
    {
      "name": "host://ui-manifest-v2",
      "host": { "file": "host/kernel/core.ts", "const": "UI_MANIFEST_V2_EVENT", "handler": "host/kernel/runtime.ts" },
      "description": "UI 清单 v2 变化（插件装卸、profile 装载与降级），payload 与 plugin:ui|manifest {version: 2} 的返回值相同；只在本 Host 收到过 v2 请求后发出（FE-A3）。",
      "payload": {
        "type": "object",
        "properties": {
          "version": { "const": 2 },
          "plugins": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "origin": { "enum": ["builtin", "community"] },
                "platforms": { "type": "array", "items": { "enum": ["desktop", "mobile"] } },
                "version": { "type": "string" },
                "file": { "type": "string" }
              },
              "required": ["id", "origin", "platforms"],
              "additionalProperties": false
            }
          },
          "degraded": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "id": { "type": "string" }, "reason": { "type": "string" } },
              "required": ["id", "reason"],
              "additionalProperties": false
            }
          },
          "safeMode": { "type": "boolean", "description": "本次 Host 会话是否处于安全模式（W06 --safe-mode）：仅官方插件，社区 UI 不得装载。" }
        },
        "required": ["version", "plugins", "degraded", "safeMode"],
        "additionalProperties": false
      }
    },
    {
      "name": "host://plugins-degraded",
      "host": { "file": "host/kernel/core.ts", "const": "PLUGINS_DEGRADED_EVENT", "handler": "host/kernel/runtime.ts" },
      "description": "profile 装载后仍有插件未安装时广播，payload 与 plugin:host|status 的返回值相同。",
      "payload": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": { "id": { "type": "string" }, "reason": { "type": "string" } },
          "required": ["id", "reason"],
          "additionalProperties": false
        }
      }
    }
  ],
  "defExtensions": {
    "L04-chat-session": {
      "CreateGroupRequest": {
        "rootFolderId": {
          "anyOf": [
            { "type": "string" },
            { "type": "null" }
          ],
          "x-option": "null"
        }
      },
      "SessionGroup": {
        "rootFolderId": {
          "anyOf": [
            { "type": "string" },
            { "type": "null" }
          ],
          "x-option": "omit"
        }
      },
      "UpdateGroupRequest": {
        "rootFolderId": {
          "anyOf": [
            { "type": "string" },
            { "type": "null" }
          ],
          "x-option": "null"
        }
      }
    }
  }
}
