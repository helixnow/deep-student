{
  "name": "deep-student-mobile",
  "private": true,
  "version": "0.20.1",
  "type": "module",
  "description": "Mobile (learning companion) prototype: same React frontend, Host in a Web Worker, SQLite WASM + OPFS storage. Dependencies are isolated from the root package.",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=8192 node_modules/vite/bin/vite.js build --mode app",
    "build:diagnostics": "vite build --mode diagnostics",
    "build:apk": "node scripts/build-apk.mjs",
    "preview": "vite preview",
    "test": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "1.60.0",
    "typescript": "5.6.3",
    "vite": "6.4.3"
  }
}
