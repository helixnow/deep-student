{
  "name": "deep-student",
  "version": "0.11.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:native": "tsgo --noEmit -p tsconfig.json",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "analyze": "ANALYZE=1 npm run build",
    "prebuild": "npm run version:generate",
    "build": "node --max-old-space-size=8192 node_modules/vite/bin/vite.js build",
    "version:generate": "node scripts/generate-version.mjs",
    "predev": "npm run version:generate",
    "dev": "vite --port 1422",
    "dev:demo": "vite --config vite.demo.config.ts --port 1423",
    "build:demo": "node --max-old-space-size=8192 node_modules/vite/bin/vite.js build --config vite.demo.config.ts",
    "preweb": "npm run version:generate",
    "web": "node web/server/main.ts",
    "prebuild:web": "npm run version:generate",
    "build:web": "node --max-old-space-size=8192 node_modules/vite/bin/vite.js build --config web/vite.config.ts",
    "web:prod": "node web/server/main.ts --prod",
    "measure:web:startup": "node scripts/ci/measure-web-startup.mjs",
    "diag:drag-trace": "node ./scripts/cdp-drag-trace.mjs",
    "diag:trace-analyze": "node ./scripts/cdp-trace-analyze.mjs",
    "predev:test": "npm run version:generate",
    "dev:test": "vite --port 1422 --open '/?test=true&debug-plugin=chat-test-runner&autorun=true'",
    "predev:test:multi-turn": "npm run version:generate",
    "dev:test:multi-turn": "vite --port 1422 --open '/?test=true&debug-plugin=chat-test-runner&autorun=true&autorun-case=basic-multi-turn'",
    "predev:test:editing": "npm run version:generate",
    "dev:test:editing": "vite --port 1422 --open '/?test=true&debug-plugin=chat-test-runner&autorun=true&autorun-case=basic-message-editing'",
    "predev:test:stop": "npm run version:generate",
    "dev:test:stop": "vite --port 1422 --open '/?test=true&debug-plugin=chat-test-runner&autorun=true&autorun-case=basic-stop-generation'",
    "mcp:test": "node ./scripts/mcp-sse-test.mjs",
    "mcp:test:ws": "node ./scripts/mcp-ws-test.mjs",
    "ui:bridge": "node ./scripts/dev/ui-bridge-server.mjs",
    "ui:drive": "node ./scripts/dev/ui-drive.mjs",
    "ui:lab": "node ./scripts/dev/ui-mobile-lab.mjs",
    "ui:lab:stop": "node ./scripts/dev/ui-mobile-lab-stop.mjs",
    "ui:mcp": "node ./scripts/dev/mcp-ui-drive.mjs",
    "ui:audit-mobile": "node ./scripts/dev/ui-audit-mobile.mjs",
    "ui:audit-mobile-tree": "node ./scripts/dev/ui-audit-mobile-tree.mjs",
    "ui:audit-mobile-deep": "node ./scripts/dev/ui-audit-mobile-deep.mjs",
    "ui:audit-mobile-all": "node ./scripts/dev/ui-audit-mobile.mjs && node ./scripts/dev/ui-audit-mobile-tree.mjs && node ./scripts/dev/ui-audit-mobile-deep.mjs",
    "dstu-test:seed-wide-sync": "node ./dstu-test/scripts/seed-wide-sync-data.mjs",
    "dstu-test:inspect-wide-sync": "node ./dstu-test/scripts/inspect-wide-sync-image.mjs",
    "dstu-test:cloud:up": "docker compose -f ./scripts/dev/docker-compose.sync-test.yml up --detach --build --wait --wait-timeout 180 minio webdav ftp && docker compose -f ./scripts/dev/docker-compose.sync-test.yml run --rm minio-init",
    "dstu-test:cloud:down": "docker compose -f ./scripts/dev/docker-compose.sync-test.yml down --volumes --remove-orphans",
    "prepreview": "npm run version:generate",
    "preview": "vite preview",
    "test": "vitest run",
    "test:plugins": "node scripts/plugins/test.mjs",
    "check:plugins": "node scripts/plugins/generate-contracts.mjs --check && node scripts/plugins/check-boundaries.mjs && tsc --noEmit -p tsconfig.plugins.json",
    "test-ct": "playwright test -c playwright-ct.config.ts",
    "test-ct:ui": "playwright test -c playwright-ct.config.ts --ui",
    "test:unit": "vitest --config vitest.config.ts",
    "test:unit:ui": "vitest --config vitest.config.ts --ui",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:css": "stylelint \"src/**/*.css\" \"src/**/*.module.css\" \"public/boot.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" \"src/**/*.module.css\" \"public/boot.css\" --fix",
    "lint:components": "eslint src/ --rule 'no-restricted-imports: error' --rule 'ds-components/no-native-button: warn'",
    "lint:components:strict": "eslint src/ --rule 'no-restricted-imports: error' --rule 'ds-components/no-native-button: error'",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:i18n:strict": "node scripts/check-i18n.mjs --strict",
    "check:i18n:missing": "node scripts/check-missing-translations.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/check-license-compliance.mjs",
    "licenses:frontend-packages": "node --max-old-space-size=8192 scripts/licenses/collect-frontend-bundle-packages.mjs",
    "check:licenses": "npm run licenses:check",
    "check:frontend-layers": "node scripts/check-frontend-layers.mjs",
    "check:lint-ratchet": "node scripts/check-lint-ratchet.mjs",
    "test:compare": "node scripts/compare-vitest-results.mjs",
    "test:lifecycle-gate": "node scripts/lifecycle-score-gate.mjs",
    "registry:sync": "node scripts/sync-model-registry.mjs",
    "postinstall": "patch-package",
    "typecheck:host": "tsc -p tsconfig.host.json",
    "test:host": "vitest run -c vitest.host.config.ts && npm run test:plugin-manager-host",
    "test:plugin-manager-host": "vitest run -c vitest.plugin-manager-host.config.ts --maxWorkers=2",
    "test:plugin-upgrade": "node host/e2e/smoke/plugin-upgrade.mts",
    "test:host:electron": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run -c vitest.host.config.ts",
    "contracts:generate": "node scripts/contracts/generate.mjs",
    "contracts:extract": "node scripts/contracts/generate.mjs",
    "contracts:check": "node scripts/contracts/generate.mjs --check",
    "dev:electron": "node electron/scripts/dev.mjs",
    "migration:boundaries": "node scripts/electron-migration/boundaries.mjs",
    "migration:boundaries:strict": "DSTU_BOUNDARY_STRICT=1 node scripts/electron-migration/boundaries.mjs",
    "migration:wiring": "node scripts/electron-migration/wiring.mjs",
    "migration:frontend-invoke": "node scripts/electron-migration/gate-checks/frontend-invoke.mjs --check",
    "migration:event-emit": "node scripts/electron-migration/gate-checks/event-emit.mjs --check",
    "migration:ui-boundaries": "node scripts/electron-migration/gate-checks/ui-boundaries.mjs --check",
    "migration:hardcoded-copy": "node scripts/electron-migration/gate-checks/hardcoded-copy.mjs --check",
    "migration:hardcoded-copy:inventory": "node scripts/electron-migration/gate-checks/hardcoded-copy.mjs --inventory",
    "migration:import-cycles": "node scripts/electron-migration/gate-checks/import-cycles.mjs --check",
    "migration:portability": "node scripts/electron-migration/gate-checks/portability.mjs --base",
    "migration:tool-coverage": "vitest run -c vitest.host.config.ts host/e2e/coverage/",
    "plugins:catalog": "node scripts/plugin-catalog/generate.mjs"
  },
